# =============================================================================
# Engram LLM configuration — universal OpenAI-compatible interface
# =============================================================================
# Engram talks to any LLM that exposes an OpenAI-style /chat/completions
# endpoint. You only need three things:
#
#   LLM_BASE_URL   the provider's API base URL (no trailing /chat/completions)
#   LLM_API_KEY    your API key
#   LLM_MODEL      the model id you want to use
#
# Streaming and non-streaming are both supported automatically — no flag.
#
# Quick presets (skip LLM_BASE_URL, just set LLM_PROVIDER + LLM_API_KEY [+ LLM_MODEL]):
#   openai | anthropic | gemini | grok | openrouter |
#   deepseek | moonshot | qwen | glm | minimax | ark | ollama
#
# Anthropic and Gemini are reached via their OpenAI-compatible endpoints,
# so the same client implementation handles every provider.
# -----------------------------------------------------------------------------

# --- Option A: explicit (works for any OpenAI-compatible provider) -----------
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini

# --- Option B: pick a preset (uncomment instead of Option A) -----------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-5

# Optional request timeout
LLM_TIMEOUT_SECONDS=60

# =============================================================================
# Embedding configuration
# =============================================================================
# Defaults to the LLM_* values above if these are unset, so for OpenAI / Qwen /
# 智谱 GLM / Ollama you typically only need to specify EMBED_MODEL.
# -----------------------------------------------------------------------------

EMBED_MODEL=text-embedding-3-small
# EMBED_BASE_URL=     # falls back to LLM_BASE_URL
# EMBED_API_KEY=      # falls back to LLM_API_KEY
# EMBED_API_STYLE=openai     # set to "ark_multimodal" for Doubao/Seed vision embedding endpoints

# =============================================================================
# Storage
# =============================================================================
DB_PATH=./data/cognitive.db
VECTOR_INDEX_PATH=./data/vectors

# =============================================================================
# Web search (optional) — sign up at https://tavily.com (free 1000/month)
# Without this key, the web_search tool degrades gracefully (returns "not configured")
# =============================================================================
TAVILY_API_KEY=
